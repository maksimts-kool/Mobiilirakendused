<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Tund2.MemoGame.LeaderboardPage"
             Title="Top tulemused"
             BackgroundColor="{DynamicResource MemoBackgroundColor}">

    <ContentPage.Resources>
        <Color x:Key="MemoBackgroundColor">#F4F7FB</Color>
        <Color x:Key="MemoTextColor">#18212F</Color>
        <Color x:Key="MemoAccentColor">#2F6FED</Color>
        <Color x:Key="MemoPanelColor">#FFFFFF</Color>
        <x:String x:Key="MemoFontFamily">PoppinsMedium</x:String>

        <Style x:Key="MemoLabelStyle"
               TargetType="Label">
            <Setter Property="TextColor"
                    Value="{DynamicResource MemoTextColor}"/>
            <Setter Property="FontFamily"
                    Value="{DynamicResource MemoFontFamily}"/>
        </Style>
    </ContentPage.Resources>

    <Grid Padding="16,20"
          RowDefinitions="Auto,*"
          RowSpacing="16"
          BackgroundColor="{DynamicResource MemoBackgroundColor}">

        <VerticalStackLayout Grid.Row="0"
                             Spacing="4">
            <Label Text="Top tulemused"
                   Style="{StaticResource MemoLabelStyle}"
                   FontSize="30"
                   FontAttributes="Bold"/>
            <Label Text="Parimad mängud punktide, aja ja käikude järgi."
                   Style="{StaticResource MemoLabelStyle}"
                   FontSize="14"
                   Opacity="0.75"/>
        </VerticalStackLayout>

        <CollectionView x:Name="ResultsCollection"
                        Grid.Row="1"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Border BackgroundColor="{DynamicResource MemoPanelColor}"
                        Stroke="{DynamicResource MemoAccentColor}"
                        Padding="16">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14"/>
                    </Border.StrokeShape>
                    <Label Text="Tulemusi veel ei ole."
                           Style="{StaticResource MemoLabelStyle}"
                           FontSize="15"/>
                </Border>
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{DynamicResource MemoPanelColor}"
                            Stroke="{DynamicResource MemoAccentColor}"
                            Padding="14"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="14"/>
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="46,*,Auto"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="12"
                              RowSpacing="6">
                            <Border Grid.RowSpan="2"
                                    Grid.Column="0"
                                    WidthRequest="42"
                                    HeightRequest="42"
                                    BackgroundColor="{Binding MedalColor}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="21"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding PlaceText}"
                                       TextColor="{Binding MedalTextColor}"
                                       FontFamily="{DynamicResource MemoFontFamily}"
                                       FontSize="17"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       VerticalTextAlignment="Center"/>
                            </Border>

                            <Label Grid.Row="0"
                                   Grid.Column="1"
                                   Text="{Binding PlayerName}"
                                   Style="{StaticResource MemoLabelStyle}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"/>
                            <Label Grid.Row="0"
                                   Grid.Column="2"
                                   Text="{Binding Points, StringFormat='{0} p'}"
                                   Style="{StaticResource MemoLabelStyle}"
                                   FontSize="18"
                                   FontAttributes="Bold"/>

                            <HorizontalStackLayout Grid.Row="1"
                                   Grid.Column="1"
                                                   Grid.ColumnSpan="2"
                                                   Spacing="14">
                                <Label Text="{Binding TimeText}"
                                       Style="{StaticResource MemoLabelStyle}"
                                       FontSize="13"
                                       Opacity="0.8"/>
                                <Label Text="{Binding MovesText}"
                                       Style="{StaticResource MemoLabelStyle}"
                                       FontSize="13"
                                       Opacity="0.8"/>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
