<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Tund2.CityExplorer.Views.FavoritesPage"
             x:Name="FavoritesRoot"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FFFFFF">
    <Grid RowDefinitions="Auto,*"
          Padding="{OnIdiom Phone='28,56,28,24', Default='44,64,44,34'}"
          RowSpacing="32">
        <Label Text="{Binding Localizer[FavoritesTitle]}"
               FontFamily="PoppinsBold"
               FontSize="{OnIdiom Phone=34, Default=38}"
               TextColor="#202020"/>

        <Grid Grid.Row="1">
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#F45158"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>

            <CollectionView ItemsSource="{Binding FavoriteGroups}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Grid Padding="18,80,18,0">
                        <Label Text="{Binding Source={x:Reference FavoritesRoot}, Path=BindingContext.Localizer[EmptyFavorites]}"
                               FontFamily="OpenSansRegular"
                               FontSize="16"
                               TextColor="#8A8A8A"
                               HorizontalTextAlignment="Center"/>
                    </Grid>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="0"
                                             Margin="0,0,0,18">
                            <Border Padding="8,8,18,8"
                                    HeightRequest="64"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding HeaderColor}">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="{Binding HeaderCornerRadius}"/>
                                </Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnGroupHeaderTapped"/>
                                </Border.GestureRecognizers>
                                <Grid ColumnDefinitions="48,*,Auto"
                                      ColumnSpacing="14">
                                    <Border WidthRequest="44"
                                            HeightRequest="44"
                                            StrokeThickness="0"
                                            BackgroundColor="#FFFFFF">
                                        <Border.StrokeShape>
                                            <shapes:RoundRectangle CornerRadius="10"/>
                                        </Border.StrokeShape>
                                        <Label Text="{Binding Icon}"
                                               FontFamily="PoppinsBold"
                                               FontSize="26"
                                               TextColor="#F0CC78"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center"/>
                                    </Border>
                                    <Label Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontFamily="PoppinsBold"
                                           FontSize="17"
                                           TextColor="#111111"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"/>
                                    <Image Grid.Column="2"
                                           Source="arrow_dropdown_black.png"
                                           Rotation="{Binding ArrowRotation}"
                                           WidthRequest="24"
                                           HeightRequest="24"
                                           Aspect="AspectFit"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </Border>

                            <Border Padding="16,14,16,18"
                                    StrokeThickness="0"
                                    BackgroundColor="{Binding BodyColor}"
                                    IsVisible="{Binding IsExpanded}"
                                    Margin="0,-2,0,0">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="0,0,16,16"/>
                                </Border.StrokeShape>
                                <FlexLayout BindableLayout.ItemsSource="{Binding Places}"
                                            Wrap="Wrap"
                                            Direction="Row"
                                            JustifyContent="Start"
                                            AlignItems="Start">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Grid FlexLayout.Basis="33.333%"
                                                  FlexLayout.Grow="0"
                                                  FlexLayout.Shrink="0"
                                                  HeightRequest="{OnIdiom Phone=120, Default=128}"
                                                  Margin="{OnIdiom Phone='0,0,0,16', Default='0,0,0,22'}">
                                                <Grid WidthRequest="{OnIdiom Phone=116, Default=124}"
                                                      HeightRequest="{OnIdiom Phone=116, Default=124}"
                                                      HorizontalOptions="Start"
                                                      VerticalOptions="Start">
                                                    <Border WidthRequest="{OnIdiom Phone=96, Default=104}"
                                                            HeightRequest="{OnIdiom Phone=96, Default=104}"
                                                            Stroke="{Binding Source={RelativeSource AncestorType={x:Type VerticalStackLayout}}, Path=BindingContext.ItemBorderColor}"
                                                            StrokeThickness="3"
                                                            BackgroundColor="#D7D7D7"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="Start">
                                                        <Border.StrokeShape>
                                                            <shapes:RoundRectangle CornerRadius="14"/>
                                                        </Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnFavoritePlaceTapped"/>
                                                        </Border.GestureRecognizers>
                                                        <Grid>
                                                            <Image Source="{Binding Image}"
                                                                   Aspect="AspectFill"/>
                                                            <BoxView Color="#000000"
                                                                     Opacity="0.34"/>
                                                            <Label Text="{Binding Name}"
                                                                   FontFamily="PoppinsBold"
                                                                   FontSize="{OnIdiom Phone=14, Default=15}"
                                                                   TextColor="#FFFFFF"
                                                                   LineBreakMode="TailTruncation"
                                                                   MaxLines="3"
                                                                   Margin="{OnIdiom Phone='9,9,8,0', Default='10,10,8,0'}"
                                                                   VerticalOptions="Start">
                                                                <Label.Shadow>
                                                                    <Shadow Brush="#DFAE3F"
                                                                            Opacity="1"
                                                                            Radius="2"
                                                                            Offset="0,1"/>
                                                                </Label.Shadow>
                                                            </Label>
                                                        </Grid>
                                                    </Border>

                                                    <Border WidthRequest="{OnIdiom Phone=48, Default=52}"
                                                            HeightRequest="{OnIdiom Phone=48, Default=52}"
                                                            Padding="4"
                                                            Stroke="{Binding Source={RelativeSource AncestorType={x:Type VerticalStackLayout}}, Path=BindingContext.ItemBorderColor}"
                                                            StrokeThickness="4"
                                                            BackgroundColor="#FFFFFF"
                                                            HorizontalOptions="End"
                                                            VerticalOptions="End">
                                                        <Border.StrokeShape>
                                                            <shapes:RoundRectangle CornerRadius="{OnIdiom Phone=24, Default=26}"/>
                                                        </Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnFavoriteBadgeTapped"/>
                                                        </Border.GestureRecognizers>
                                                        <Image Source="liked.png"
                                                               Aspect="AspectFit"
                                                               WidthRequest="{OnIdiom Phone=34, Default=38}"
                                                               HeightRequest="{OnIdiom Phone=34, Default=38}"
                                                               HorizontalOptions="Center"
                                                               VerticalOptions="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </Border>
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
