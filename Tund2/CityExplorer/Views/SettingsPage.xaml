<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="Tund2.CityExplorer.Views.SettingsPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FFFFFF">
    <Grid RowDefinitions="Auto,*"
          Padding="{OnIdiom Phone='28,56,28,24', Default='44,64,44,34'}"
          RowSpacing="42">
        <Label Text="{Binding Localizer[SettingsTitle]}"
               FontFamily="PoppinsBold"
               FontSize="{OnIdiom Phone=34, Default=38}"
               TextColor="#202020"/>

        <Border Grid.Row="1"
                Padding="18"
                StrokeThickness="0"
                BackgroundColor="#FAFAFA"
                VerticalOptions="Start">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="18"/>
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="14">
                <Label Text="{Binding Localizer[Language]}"
                       FontFamily="PoppinsBold"
                       FontSize="18"
                       TextColor="#202020"/>

                <Label Text="{Binding CurrentLanguageText}"
                       FontFamily="OpenSansRegular"
                       FontSize="14"
                       TextColor="#777777"/>

                <Grid ColumnDefinitions="*,*,*"
                      ColumnSpacing="10"
                      Margin="0,4,0,0">
                    <Button Text="{Binding Localizer[Estonian]}"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="et"
                            BackgroundColor="#F45158"
                            TextColor="#FFFFFF"
                            FontFamily="PoppinsMedium"
                            FontSize="13"
                            CornerRadius="18"/>
                    <Button Grid.Column="1"
                            Text="{Binding Localizer[English]}"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="en"
                            BackgroundColor="#8BE3C3"
                            TextColor="#111111"
                            FontFamily="PoppinsMedium"
                            FontSize="13"
                            CornerRadius="18"/>
                    <Button Grid.Column="2"
                            Text="{Binding Localizer[Russian]}"
                            Command="{Binding ChangeLanguageCommand}"
                            CommandParameter="ru"
                            BackgroundColor="#F1D38B"
                            TextColor="#111111"
                            FontFamily="PoppinsMedium"
                            FontSize="13"
                            CornerRadius="18"/>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
